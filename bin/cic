#!/usr/bin/env python3
"""Zero-install launcher for cic: resolves the package next to this script (symlinks included)."""

import os
import sys

if sys.version_info < (3, 10):
    sys.stderr.write("cic needs Python 3.10 or newer\n")
    sys.exit(2)

_root = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
sys.path.insert(0, os.path.join(_root, "src"))

from cic.cli import main  # noqa: E402

sys.exit(main())
